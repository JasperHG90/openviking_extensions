# Copy to .env and fill in. Every value is checked at boot; a missing one names
# itself in the error rather than failing on the first request that needs it.

# ── OpenViking ───────────────────────────────────────────────────
# In-cluster address. Use the API hostname from outside the cluster.
OV_URL=http://openviking:1933
# 60s, not 30s: grep takes about twenty seconds per term against a real
# instance while everything else answers in under one, so a 30s budget times
# out exact search alone.
OV_TIMEOUT_MS=60000
# The scope the dashboard shows. {user} and {account} are substituted.
# The uid-less spelling "viking://user" is NOT a shorter way to write this —
# OpenViking rejects it and points at the viking://~/... home alias — so a root
# without the id silently breaks memories and semantic search.
OV_ROOT=viking://user/{user}
# The scope shared with everyone in the account, offered as a second place to
# write. Leave empty to offer only the person's own tree.
OV_SHARED_ROOT=viking://resources

# ── who is calling ───────────────────────────────────────────────
# vault-oidc      the person is sent to Vault's own login page, and the ID
#                 token that comes back is the credential OpenViking accepts.
#                 No password reaches the dashboard, so Vault's MFA applies
#                 without it knowing. Start here -- see the README for the
#                 three Vault resources it needs.
# vault-userpass  the same job through a password form: the dashboard logs
#                 into Vault and mints the token itself. Needs nothing
#                 registered anywhere, and is the only mode that handles a
#                 password.
# oidc            the redirect against some other provider, keeping only an
#                 identity from it and looking a key up per request.
# trusted-header  an authenticating proxy in front already did it
# dev             one fixed identity, for working on the UI
AUTH_MODE=vault-oidc

# The public URL people reach. The redirect URI is derived from it, and must
# match the client's redirect_uris in Vault exactly.
PUBLIC_ORIGIN=https://dash.example.com

# Vault's OIDC provider. The discovery document is fetched from here, and the
# issuer it declares must equal this or the sign-in is refused.
OIDC_ISSUER=https://vault.example.com/v1/identity/oidc/provider/default
# Vault generates both when the client is created; neither is a name you pick.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Left unset, this is "openid openviking" under vault-oidc: the second scope is
# what puts ov_account and ov_user in the token. Set it only if your Vault
# scope is called something else. Do not add `email` or `groups` -- Vault does
# not advertise them, and asking is an invalid_scope refusal.
# OIDC_SCOPES=openid openviking

# Needed when AUTH_MODE=vault-userpass, and not read under vault-oidc, which
# reaches Vault through OIDC_ISSUER alone.
# VAULT_ADDR=https://vault.example.com
# The userpass mount people sign in against.
VAULT_USERPASS_MOUNT=userpass
# The identity-token role minted from. It must template ov_account and ov_user,
# because that is where OpenViking reads identity from. A session lasts for the
# shorter of its TTL and SESSION_TTL_SECONDS below, and nothing renews one.
VAULT_OIDC_ROLE=openviking

# Which claim becomes the OpenViking user. Read under AUTH_MODE=oidc and
# trusted-header only: the Vault modes read ov_user out of the token, which is
# the identity OpenViking answers as rather than a claim to map from.
IDENTITY_FROM=email-local
# Require the provider to have verified the address before mapping from it.
# Leave on unless your provider omits the claim entirely: off, anyone who can
# set an unverified email can claim another person's local part, and their key.
OIDC_REQUIRE_EMAIL_VERIFIED=true
# Comma-separated domains allowed to sign in. Worth setting whenever
# IDENTITY_FROM=email-local, which discards the domain: without it,
# jasper@corp.example and jasper@contractor.example are ONE OpenViking user
# sharing one tree. Not read under vault-oidc, which maps nothing from email.
OIDC_ALLOWED_EMAIL_DOMAINS=
# Leave empty to use the same value for account and user (the post-OV2 shape).
OV_ACCOUNT=

# ── sessions ─────────────────────────────────────────────────────
# 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true

# ── API keys ─────────────────────────────────────────────────────
# Only read when AUTH_MODE is oidc, trusted-header or dev. Under vault-oidc and
# vault-userpass the sign-in itself produces the credential, so there is no key
# to look up and none of this is used -- leave it as it is.
#
# vault       read each person's key from Vault KV (production)
# static-map  a JSON object of user -> key
# env         one key for every caller (single-user or local only)
KEY_SOURCE=vault
KEY_CACHE_TTL_SECONDS=300

VAULT_KV_MOUNT=secret
# {user} is replaced with the OpenViking user resolved above.
VAULT_KEY_PATH=openviking-users/{user}
VAULT_KEY_FIELD=api_key
# Either a token, or an AppRole the dashboard logs in with.
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── local development ────────────────────────────────────────────
# AUTH_MODE=dev
# KEY_SOURCE=env
# OV_API_KEY=ov_your_key
# SESSION_COOKIE_SECURE=false
# PUBLIC_ORIGIN=http://localhost:8080
