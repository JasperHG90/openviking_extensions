# macOS writes one of these into every directory it browses.
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/

# Node. The npm packages under packages/ install here, and their tooling
# writes caches into it, so leaving it untracked also keeps `prek` from
# reporting a test run as a working-tree change.
node_modules/
web-ext-artifacts/

# Environments
.venv/

# Generated by hatch-vcs at build time
packages/ov-postgres/src/ov_postgres/_version.py
packages/ov-ext/src/ov_ext/_version.py

# OpenViking runtime workspace: queue database, usage audit, local vector
# index, and the server pid file. Machine state, not source.
data/

*.code-workspace

# OpenViking's own workspace: ingested documents, extracted media, session
# state. Never source, and it can hold private material.
.openviking/
